APP_NAME=SellPlataform
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sellplataform.onrender.com

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_URL=
DB_SSLMODE=require

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_URL=

MAIL_MAILER=resend
MAIL_FROM_ADDRESS="hello@victorsf.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=
